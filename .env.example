# Jamie — The only WC agent you need
# Copy to .env and adjust as needed.

# Application mode
APP_MODE=analytics
ENABLE_LIVE_TRADING=false

# User jurisdiction (ISO 3166-1 alpha-2). Leave empty for auto-detect via geoblock.
USER_COUNTRY_CODE=US

# Polymarket platform: us (regulated US) or international (polymarket.com)
# US residents should use us. Auto-detected when country is US.
POLYMARKET_PLATFORM=us

# Optional Polymarket US API keys (only needed for account/orders; public market data works without keys)
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# International Polymarket public API (read-only; blocked for US users)
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock

# Risk defaults
DEFAULT_BANKROLL=70
MODELING_MATCH_LIMIT=6000
ELO_MATCH_LIMIT=20000
FAST_TRAIN_SKIP_CALIBRATION=false
DEFAULT_MIN_EDGE=0.07
DEFAULT_MAX_SPREAD=0.05
DEFAULT_MIN_LIQUIDITY=100
DEFAULT_KELLY_MULTIPLIER=0.08
DEFAULT_MAX_RISK_PER_TRADE=0.005
DEFAULT_MAX_EXPOSURE_PER_MATCH=0.015
DEFAULT_MAX_TOTAL_EXPOSURE=0.06
MIN_TICKET_SIZE=1.0

# Optional sentiment (Phase 3)
TWITTER_BEARER_TOKEN=
HUGGINGFACE_API_KEY=
